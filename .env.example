# Required: safe to use on the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Generate a fresh 64-character hex secret with:
# openssl rand -hex 32
# Never use a demo or committed value for a deployed instance.
VAC_REGISTRATION_SECRET=

# Optional legacy fallback. Prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Drive sync. A Vercel deployment needs its own credentials.
# Share the destination folder with the service account before enabling.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_FOLDER_ID=

# Optional: private server-side President acknowledgement artwork.
# Keep artwork outside source control. Never prefix this with NEXT_PUBLIC_.
# VAC_PRESIDENT_SIGNATURE_PATH=
